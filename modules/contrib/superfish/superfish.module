<?php

/**
 * @file
 * The jQuery Superfish plugin for Drupal menus.
 */

use Drupal\Core\Block\BlockPluginInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\superfish\Hook\CoreHooks;
use Drupal\superfish\Hook\LibraryHooks;
use Drupal\superfish\Hook\ThemeHooks;

/**
 * Implements hook_block_view_BASE_BLOCK_ID_alter().
 */
#[LegacyHook]
function superfish_block_view_superfish_alter(array &$build, BlockPluginInterface $block) {
  \Drupal::service(ThemeHooks::class)->blockViewSuperfishAlter($build, $block);
}

/**
 * Implements hook_libraries_info().
 */
#[LegacyHook]
function superfish_libraries_info() {
  return \Drupal::service(LibraryHooks::class)->librariesInfo();
}

/**
 * Implements hook_library_info_build().
 */
#[LegacyHook]
function superfish_library_info_build() {
  return \Drupal::service(LibraryHooks::class)->libraryInfoBuild();
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function superfish_theme($existing, $type, $theme, $path) {
  return \Drupal::service(ThemeHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function superfish_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(CoreHooks::class)->help($route_name, $route_match);
}
